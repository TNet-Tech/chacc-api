# ChaCC API - Production Environment Variables
# Copy this file to .env and fill in the values

SECRET_KEY=changeme-to-a-secure-random-32-char-key

DB_PASSWORD=changeme-to-a-secure-db-password
DATABASE_ENGINE=postgresql
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=chacc
DATABASE_USER=chacc

# Migration Settings
# Options: preview (show only), auto (safe, no drops), full (all operations)
MIGRATION_MODE=auto
# Set to true/false to override auto backup (default: true in production)
# MIGRATION_BACKUP=true
# Directory for database backups
MIGRATION_BACKUP_DIR=backups
# Allow destructive operations in auto mode (drop table, column, etc.)
MIGRATION_AUTO_DROP=false

# (DO NOT CHANGE THESE)
CHACC_DEV_MODE=false
ENABLE_PLUGIN_HOT_RELOAD=False
ENABLE_PLUGIN_DEPENDENCY_RESOLUTION=False
PLUGIN_AUTO_DISCOVERY=False
NO_RELOAD=True

#Only applies if you use Official ChaCC Authentication module 
AUTHENTICATION_DEFAULT_ADMIN_USERNAME=admin
AUTHENTICATION_ADMIN_PASSWORD=ChangeMe123!

# Rate limiting (see the Configuration docs)
RATE_LIMIT_ENABLED=true
# memory:// is per container and reset on restart. With several containers, or to
# keep counts across restarts, use Redis: redis://[:password@]redis:6379/0
RATE_LIMIT_STORAGE_URI=memory://
# Behind a reverse proxy, its address, so clients are counted by their own IP:
# FORWARDED_ALLOW_IPS=172.18.0.1

LOG_LEVEL=INFO
