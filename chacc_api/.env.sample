# ============================================================
# ChaCC API – Environment Configuration
# Copy this file to .env and customise for your environment.
# Do NOT commit .env to version control.
# ============================================================


# -----------------------------------------------------------------
# Database
# -----------------------------------------------------------------
# Options: sqlite (default) | postgresql
DATABASE_ENGINE=sqlite
SQLITE_DATABASE_NAME=chaccapi
#This uses current working directory by default
#SQLITE_DATABASE_PATH=

# SQLite does not require additional settings.
# Uncomment and configure the block below when using PostgreSQL.
#
# DATABASE_ENGINE=postgresql
# DATABASE_USER=chaccapi
# DATABASE_PASSWORD=chaccapi
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=chaccapidb




# -----------------------------------------------------------------
# ChaCC CLI (deploy command)
# -----------------------------------------------------------------
CHACC_DEPLOY_URL=http://localhost:8085
# Optional – API key for authenticated deployments.
CHACC_DEPLOY_API_KEY=
# HTTP timeout in seconds for deploy requests (default: 30).
CHACC_DEPLOY_TIMEOUT=30


# -----------------------------------------------------------------
# Development Mode Configuration (used when running `chacc run server --dev`)
# -----------------------------------------------------------------
ENABLE_PLUGIN_HOT_RELOAD=False
ENABLE_PLUGIN_DEPENDENCY_RESOLUTION=False
PLUGIN_AUTO_DISCOVERY=False


# -----------------------------------------------------------------
# Plugin / Module Directories
# -----------------------------------------------------------------
# Where chacc cli scaffolds new modules to.
PLUGINS_DIR=plugins
# Directory where .chacc packages are stored before loading.
MODULES_INSTALLED_DIR=.modules_installed
# Directory where modules are extracted and imported from.
MODULES_LOADED_DIR=.modules_loaded
# Temporary staging directory for uploads.
MODULES_UPLOAD_DIR=.modules_upload
# Cache directory for compiled dependency requirements.
DEPENDENCY_CACHE_DIR=.chacc_cache


# -----------------------------------------------------------------
# Migration Settings (applied automatically at startup)
# -----------------------------------------------------------------
# Options: preview (show only) | auto (safe, no drops) | full (all operations)
MIGRATION_MODE=auto
MIGRATION_BACKUP=false
MIGRATION_BACKUP_DIR=backups
MIGRATION_AUTO_DROP=false


# -----------------------------------------------------------------
# JWT Secret (Works with chacc official authentication module and should be set to a strong random value in production)
# -----------------------------------------------------------------
SECRET_KEY=your-secret-key-here


# -----------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------
CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*


# -----------------------------------------------------------------
# Redis (Optional – token management, rate-limit storage, caching)
# -----------------------------------------------------------------
# Set REDIS_ENABLED=true only if you have a Redis instance running.
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
