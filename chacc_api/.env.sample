# ============================================================
# ChaCC API – Environment Configuration
# Copy this file to .env and customise for your environment.
# Do NOT commit .env to version control.
# ============================================================


# -----------------------------------------------------------------
# Database
# -----------------------------------------------------------------
# Options: sqlite (default) | postgresql
DATABASE_ENGINE=sqlite
SQLITE_DATABASE_NAME=chaccapi
#This uses current working directory by default
#SQLITE_DATABASE_PATH=

# SQLite does not require additional settings.
# Uncomment and configure the block below when using PostgreSQL.
#
# DATABASE_ENGINE=postgresql
# DATABASE_USER=chaccapi
# DATABASE_PASSWORD=chaccapi
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=chaccapidb




# -----------------------------------------------------------------
# ChaCC CLI (deploy command)
# -----------------------------------------------------------------
CHACC_DEPLOY_URL=http://localhost:8085
# Optional – API key for authenticated deployments.
CHACC_DEPLOY_API_KEY=
# Optional – credentials used when the server returns 401 (otherwise you are prompted).
#CHACC_DEPLOY_USERNAME=
#CHACC_DEPLOY_PASSWORD=
#CHACC_DEPLOY_AUTH_PATH=/authentication
#CHACC_DEPLOY_API_PREFIX=/api
# Seconds to wait for the server response after upload (default: 600).
CHACC_DEPLOY_TIMEOUT=600
# Seconds `chacc deploy --restart` waits for the server to come back (default: 180).
#CHACC_DEPLOY_RESTART_TIMEOUT=180


# -----------------------------------------------------------------
# Development Mode Configuration (used when running `chacc run server --dev`)
# -----------------------------------------------------------------
ENABLE_PLUGIN_HOT_RELOAD=False
ENABLE_PLUGIN_DEPENDENCY_RESOLUTION=False
PLUGIN_AUTO_DISCOVERY=False


# -----------------------------------------------------------------
# Module packages (production)
# -----------------------------------------------------------------
# Where modules' Python packages are installed (keep it on persistent storage).
#MODULE_PACKAGES_DIR=.chacc_packages
# At startup: "missing" installs packages that are missing (needs network),
# "never" only checks and skips modules whose packages are missing.
#CHACC_BOOT_INSTALL=missing
# Seconds to spend installing missing packages at startup (default: 120).
#CHACC_BOOT_INSTALL_TIMEOUT=120


# -----------------------------------------------------------------
# Migration Settings (applied automatically at startup)
# -----------------------------------------------------------------
# Options: preview (show only) | auto (safe, no drops) | full (all operations)
MIGRATION_MODE=auto
MIGRATION_BACKUP=false
MIGRATION_BACKUP_DIR=backups
MIGRATION_AUTO_DROP=false


# -----------------------------------------------------------------
# JWT Secret (Works with chacc official authentication module and should be set to a strong random value in production)
# -----------------------------------------------------------------
SECRET_KEY=your-secret-key-here


# -----------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------
CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*


# -----------------------------------------------------------------
# Redis (Optional – token management, rate-limit storage, caching)
# -----------------------------------------------------------------
# Set REDIS_ENABLED=true only if you have a Redis instance running.
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
