# SQLite is the default db, you can use default / sqlite and both will resort to using sqlite db 
DATABASE_ENGINE=default

#For postgresql, uncomment and update the below values
# DATABASE_ENGINE=postgresql
# DATABASE_USER=chaccapi
# DATABASE_PASSWORD=welcome2chaccapi
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=chaccapidb


# ChaCC CLI
CHACC_DEPLOY_URL=http://localhost:8080

# Development Mode Configuration (used when running `chacc run server --dev`)
ENABLE_PLUGIN_HOT_RELOAD=True
ENABLE_PLUGIN_DEPENDENCY_RESOLUTION=True
PLUGIN_AUTO_DISCOVERY=True

# Migration Settings
# Options: preview (show only) | auto (safe, no drops) | full (all operations)
MIGRATION_MODE=auto
MIGRATION_BACKUP=false
MIGRATION_BACKUP_DIR=backups
MIGRATION_AUTO_DROP=false
MIGRATION_AUTO_DROP=false

# Default Admin User (created by official chacc authentication module if no users exist)
AUTHENTICATION_DEFAULT_ADMIN_USERNAME=admin
AUTHENTICATION_DEFAULT_ADMIN_PASSWORD=admin

SECRET_KEY=your-secret-key-here

# CORS Configuration
CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*


# Development environment
PLUGINS_DIR=plugins # Where should chacc cli scaffold modules to.

# Redis Configuration (Optional - for token management, caching)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=